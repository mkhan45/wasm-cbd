// Projection stress: an outside use of x can make projected contexts see stale
// parent demand for the crossed p/q subproblem.
def PROJECTED_CONTEXT_STALE_DEMAND() {
	var c1 = pop_u32();
	var c2 = pop_u32();
	var c3 = pop_u32();
	var p = u32.!=(c1, 0);
	var q = u32.!=(c2, 0);
	var r = u32.!=(c3, 0);
	var x = pop_u32();

	var outside: u32 = 0;
	if (r) {
		outside = u32.+(x, 100);
	} else {
		outside = 7;
	}

	var left: u32 = 0;
	if (p) {
		if (q) {
			left = u32.+(x, 1);
		} else {
			left = 11;
		}
	} else {
		left = 12;
	}

	var right: u32 = 0;
	if (q) {
		if (p) {
			right = u32.+(x, 2);
		} else {
			right = 21;
		}
	} else {
		right = 22;
	}

	push_u32(u32.+(outside, u32.+(left, right)));
}

// Projection/escaping stress: x's direct consumer is the pure wrapper sx. The
// p-site can treat sx as internal even though sx also feeds the outer q site,
// which risks cloning x through the wrapper.
def PROJECTED_CONTEXT_ESCAPING_WRAPPER() {
	var c1 = pop_u32();
	var c2 = pop_u32();
	var p = u32.!=(c1, 0);
	var q = u32.!=(c2, 0);
	var x = pop_u32();
	var sx = u32.+(x, 0);

	var outer: u32 = 0;
	if (q) {
		outer = u32.+(sx, 1);
	} else {
		outer = 10;
	}

	var left: u32 = 0;
	var right: u32 = 0;
	if (p) {
		if (q) {
			left = u32.+(sx, 2);
		} else {
			left = 20;
		}
		right = 30;
	} else {
		left = 40;
		if (q) {
			right = u32.+(sx, 3);
		} else {
			right = 50;
		}
	}

	push_u32(u32.+(outer, u32.+(left, right)));
}
// Inner-phi cloneable_overlap that includes a node from outer P1's frontier:
// d is non-effectful but lives in P1.cond_deps (so in P1.frontier). Two phis
// e and f at condition alpha both have d on their left arm. P2 (q-phi) uses
// e on left and f on right. Phi-aware short-circuits at e and f, so d is NOT
// in P2.frontier — d ends up in P2.l_subgraph ∩ P2.r_subgraph (cloneable).
//
// Old slice-based algorithm correctly excluded d from P2's cloneable in slice
// = P1.left_region (which doesn't include P1.frontier). The simplified
// algorithm clips only to bottom_active and would clone d, redirecting f's
// left arm (since f is in P2.right_only) to a clone d'. Then e and f share
// condition alpha but their left-arm inputs (d vs d') live in incompatible
// CFG scopes, breaking the schedule.
def INNER_PHI_FRONTIER_LEAK() {
	var c = pop_u32();
	var d = u32.+(c, 1);
	var p = u32.!=(d, 0);

	var k = pop_u32();
	var alpha = u32.!=(k, 0);

	var e: u32 = 0;
	if (alpha) { e = d; } else { e = 100; }

	var f: u32 = 0;
	if (alpha) { f = d; } else { f = 200; }

	var m = pop_u32();
	var q = u32.!=(m, 0);

	var result: u32 = 0;
	if (p) {
		if (q) {
			result = u32.+(e, 1);
		} else {
			result = u32.+(f, 2);
		}
	} else {
		result = 999;
	}

	push_u32(result);
}
//@bytecode end
