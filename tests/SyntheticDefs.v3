// Minimal type declarations for synthetic opcode testing.
// These mirror the subset of CanonicalDefs.v3 needed by the test opcodes.
def pop_u32() -> u32 #stage<I -> I> #rw(Stack);
def push_u32(v: u32) #stage<I -> I> #rw(Stack);

//===================================================================================================
//@bytecode start
def SPLIT_BRANCHES() {
    // inspired by VSDG thesis
    var c1 = pop_u32();
    var p = u32.!=(c1, 0);
    var q = u32.==(c1, 2);
    if (p) {
        if (q) {
            push_u32(1);
            push_u32(2);
        } else {
            push_u32(3);
            push_u32(4);
        }
    } else {
        if (q) {
            push_u32(5);
            push_u32(6);
        } else {
            push_u32(7);
            push_u32(8);
        }
    }
}
def SPLIT_BRANCHES_PHI() {
    var c1 = pop_u32();
    var r3: u32 = 0;
    var r4: u32 = 1;
    var p = u32.!=(c1, 0);
    var q = u32.==(c1, 2);
    if (p) {
        if (q) {
            r3 = 1;
            r4 = 2;
        } else {
            r3 = 3;
            r4 = 4;
        }
    } else {
        if (q) {
            r3 = 5;
            r4 = 6;
        } else {
            r3 = 6;
            r4 = 7;
        }
    }
    push_u32(r3);
    push_u32(r4);
}
// P3 counterexample from GRAPH_PROPS.md: tests phi-aware traversal
// through nested phis with a trivial phi (same value on both arms).
//
// Sea graph produced:
//   deepPhi  = phi(q, A, B)           -- A on q=T only
//   N        = u32.+(deepPhi, 0)      -- pure wrapper
//   trivPhi  = phi(r, N, N)           -- trivially N on both arms
//   outerPhi = phi(p, trivPhi, h(A))  -- A shared across outer branches
//
// In the old buggy code (transitiveDepsSet in transitiveDepsPhiAwareAux),
// the full traversal through trivPhi's common-set computation would bleed
// through deepPhi's arms, pulling A into l_phi_aware. Combined with A in
// r_phi_aware (via h(A)), A would be incorrectly placed in the frontier.
//
// In SSAD, A = pop_u32() is unconditional (defined before all ifs), so
// frontier placement is actually correct here. The test verifies the
// scheduler handles this nested-phi pattern without errors.
def P3_FRONTIER() {
	var c1 = pop_u32();
	var c3 = pop_u32();
	var c2 = pop_u32();
	var A = pop_u32();
	var B = pop_u32();
	var p = u32.!=(c1, 0);
	var q = u32.!=(c3, 0);
	var r = u32.!=(c2, 0);
	var deep: u32 = 0;
	if (q) {
		deep = A;
	} else {
		deep = B;
	}
	var N = u32.+(deep, 0);
	var triv: u32 = 0;
	if (r) {
		triv = N;
	} else {
		triv = N;
	}
	var result: u32 = 0;
	if (p) {
		result = triv;
	} else {
		result = u32.+(A, 1);
	}
	push_u32(result);
}

def EFFECT_LIFT_OVER_PARENT_COND() {
	var c1 = pop_u32();
	var c2 = pop_u32();
	var p = u32.!=(c1, 0);
	var q = u32.!=(c2, 0);

	var x: u32 = 0;
	if (p) {
		x = pop_u32();
	} else {
		x = 7;
	}

	var y: u32 = 0;
	if (q) {
		y = u32.+(x, 1);
	} else {
		y = 9;
	}

	var z: u32 = 0;
	if (p) {
		z = y;
	} else {
		z = 3;
	}

	push_u32(z);
}
// Hard because the same q-shaped effect appears on both sides of p, so unLEM
// has to preserve scope while reusing condition structure across branches.
// Fails in: unLEM.
// Symptom: over-executes both inner pops on paths where q is false,
// producing PathEffectMismatch.
def SAME_SCOPE_Q_ON_BOTH_P_SIDES() {
	var c1 = pop_u32();
	var c2 = pop_u32();
	var p = u32.!=(c1, 0);
	var q = u32.!=(c2, 0);

	var left: u32 = 0;
	if (p) {
		var inner: u32 = 0;
		if (q) {
			inner = pop_u32();
		} else {
			inner = 11;
		}
		left = u32.+(inner, 1);
	} else {
		var inner: u32 = 0;
		if (q) {
			inner = pop_u32();
		} else {
			inner = 21;
		}
		left = u32.+(inner, 2);
	}

	push_u32(left);
}

def P3_EFFECTFUL_VARIANT() {
	var c1 = pop_u32();
	var c2 = pop_u32();
	var c3 = pop_u32();
	var p = u32.!=(c1, 0);
	var q = u32.!=(c2, 0);
	var r = u32.!=(c3, 0);

	var A: u32 = 0;
	if (q) {
		A = pop_u32();
	} else {
		A = 5;
	}

	var B = u32.+(A, 0);

	var triv: u32 = 0;
	if (r) {
		triv = B;
	} else {
		triv = B;
	}

	var out: u32 = 0;
	if (p) {
		out = triv;
	} else {
		out = u32.+(A, 1);
	}

	push_u32(out);
}

// Very hard because unLEM turns this nested p/q/r bundle into a dense web of
// interacting value/state phis and merges with repeated use of the same effect.
// Fails in: unLEM.
// Symptom: UnsatNeed, UnscheduledPhi, PhiBranchMissing, and many
// PathEffectMismatch errors.
def UNLEM_IMPOSSIBLE_ASSIGNMENT_BUNDLE() {
	var c1 = pop_u32();
	var c2 = pop_u32();
	var c3 = pop_u32();
	var p = u32.!=(c1, 0);
	var q = u32.!=(c2, 0);
	var r = u32.!=(c3, 0);

	var x: u32 = 0;
	if (p) {
		if (q) {
			x = pop_u32();
		} else {
			x = 10;
		}
	} else {
		if (q) {
			x = pop_u32();
		} else {
			x = 20;
		}
	}

	var y: u32 = 0;
	if (r) {
		y = u32.+(x, 1);
	} else {
		y = u32.+(x, 2);
	}

	var z: u32 = 0;
	if (p) {
		z = y;
	} else {
		z = u32.+(x, 3);
	}

	push_u32(z);
}

// Very hard because overlapping p/q/r/s braids create a large non-laminar
// branch lattice that grows sharply after unLEM.
// Fails in: unLEM.
// Symptom: scheduler blows up with HeapOverflow before checker results.
def UNTANGLE_BRAID_LIMIT_STRESS() {
	var c1 = pop_u32();
	var c2 = pop_u32();
	var c3 = pop_u32();
	var c4 = pop_u32();
	var p = u32.!=(c1, 0);
	var q = u32.!=(c2, 0);
	var r = u32.!=(c3, 0);
	var s = u32.!=(c4, 0);

	var seed = pop_u32();

	var a: u32 = 0;
	if (p) {
		if (q) {
			a = u32.+(seed, 1);
		} else {
			a = 10;
		}
	} else {
		if (r) {
			a = u32.+(seed, 2);
		} else {
			a = 20;
		}
	}

	var b: u32 = 0;
	if (q) {
		if (r) {
			b = u32.+(a, 1);
		} else {
			b = u32.+(seed, 3);
		}
	} else {
		if (s) {
			b = u32.+(a, 2);
		} else {
			b = 30;
		}
	}

	var c: u32 = 0;
	if (r) {
		if (s) {
			c = u32.+(b, 1);
		} else {
			c = u32.+(a, 3);
		}
	} else {
		if (p) {
			c = u32.+(b, 2);
		} else {
			c = u32.+(seed, 4);
		}
	}

	push_u32(c);
}

