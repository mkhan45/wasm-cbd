// Hard because the same effectful pop is shared through crossed p->q and q->p
// nestings, so there is no simple laminar branch structure to schedule.
// Fails in: initial.
// Symptom: leaves phis unscheduled and misses the pop on all paths, yielding
// UnsatNeed, UnscheduledPhi, and PathEffectMismatch.
def CROSSED_P_Q_SHARED_POP() {
	var c1 = pop_u32();
	var c2 = pop_u32();
	var p = u32.!=(c1, 0);
	var q = u32.!=(c2, 0);

	var x = pop_u32();

	var left: u32 = 0;
	if (p) {
		if (q) {
			left = u32.+(x, 1);
		} else {
			left = 11;
		}
	} else {
		left = 12;
	}

	var right: u32 = 0;
	if (q) {
		if (p) {
			right = u32.+(x, 2);
		} else {
			right = 21;
		}
	} else {
		right = 22;
	}

	push_u32(left);
	push_u32(right);
}

// Initial-scheduler stress: two sibling phis under one condition, with later
// users that each consume both phis. This targets grouped phi readiness and
// use-count bookkeeping.
def Q_PAIR_CHILD_UNDERCOUNT() {
	var c1 = pop_u32();
	var q = u32.!=(c1, 0);

	var a: u32 = 0;
	var b: u32 = 0;
	if (q) {
		a = pop_u32();
		b = pop_u32();
	} else {
		a = 11;
		b = 22;
	}

	var u1 = u32.+(a, b);
	var u2 = u32.+(b, a);
	var u3 = u32.+(u1, u2);

	push_u32(u1);
	push_u32(u2);
	push_u32(u3);
}

