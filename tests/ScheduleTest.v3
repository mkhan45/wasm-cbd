def SYNTHETIC_V3   = "./tests/SyntheticDefs.v3";
def SYNTHETIC_SEXP = "./tests/SyntheticDefs.v3.sexp";
def CANONICAL_V3   = "./wizard-engine/src/bytecode/CanonicalDefs.v3";
def CANONICAL_SEXP = "./wizard-engine/src/bytecode/CanonicalDefs.v3.sexp";
def TRACES_FILE    = "docs/traces.js";

var total_tests: int = 0;
var total_pass: int = 0;
var total_fail: int = 0;
var trace_opcodes: Array<string> = ["IF", "IF_ul"];

def should_trace(opcode: string) -> bool {
	for (name in trace_opcodes) if (Strings.equal(name, opcode)) return true;
	return false;
}

def reportResult(opcode: string, phase: string, errors: Vector<ScheduleError>) {
	total_tests += 1;
	if (errors.length == 0) {
		total_pass += 1;
		System.puts(Strings.format2("  PASS  %s [%s]\n", opcode, phase));
	} else {
		total_fail += 1;
		System.puts(Strings.format2("  FAIL  %s [%s]\n", opcode, phase));
		for (i < errors.length) System.puts(Strings.format2("        %d: %q\n", i, errors[i].render));
	}
}

def testOpcode(opcode: string, stmt: VirgilStmt) -> CBDDef {
	var ir = SSAD_IR.from_virgil(stmt);
	var sea_ir = ir;

        def trace = should_trace(opcode);

        if (trace) {
            System.puts(Strings.format1("--- %s raw SSAD ---\n", opcode));
            System.puts(sea_ir.toString(0));
            System.puts("\n---\n");
        }

	def sea_info = Seas.ofSSADWithInfo(sea_ir);
	var sea = sea_info.0;
	def ssad_sea_info = sea_info.1;
	sea.apply(void, SeaTransforms.id_propagate);

	CBDTrace.addCode(opcode, "parsed", sea_ir.toString(0));
	CBDTrace.addCode(opcode, "initial_pretty", sea_ir.toStringPretty(0));
	CBDTrace.addGraph(opcode, "raw", sea);

	// --- Test 1: schedule the initial graph ---
	var scheduler = Scheduler.of_full_sea_info(sea, ssad_sea_info);
	scheduler.opcode = opcode;
	scheduler.trace_full = should_trace(opcode);
	scheduler.schedule();

	CBDTrace.addString(opcode, "schedulerMermaid", "graph", scheduler.toMermaid());
	def scheduler_ssad_info = scheduler.bottom_block.toSSADSeaInfo();
	def scheduler_ssad = scheduler_ssad_info.0;
	def scheduler_sea_info = scheduler_ssad_info.1;
        def ssad_string = scheduler_ssad.toString(0);
        def ssad_string_pretty = scheduler_ssad.toStringPrettyWithSeaInfo(0, scheduler_sea_info);
	CBDTrace.addCode(opcode, "scheduler_ssad", ssad_string);
	CBDTrace.addCode(opcode, "scheduler_ssad_pretty", ssad_string_pretty);
        if (trace) {
            System.puts(Strings.format1("--- %s [initial] raw SSAD ---\n", opcode));
            System.puts(ssad_string);
            System.puts("\n---\n");
            System.puts(Strings.format1("--- %s [initial] pretty SSAD ---\n", opcode));
            System.puts(ssad_string_pretty);
            System.puts("\n---\n");
        }

	var sc = ScheduleChecker.new(
		scheduler.top_block, scheduler.bottom_block,
		scheduler.orig_sea, scheduler.sea,
		scheduler.mapping, scheduler.clone_to_orig);
	sc.check();
	reportResult(opcode, "initial", sc.errors);

	// --- Test 2: apply unLEM, then schedule again ---
	def state = NodeMap<(IRNode, Vector<IRNode>)>.new();
	sea.apply(state, SeaTransforms.unLEM);
        def ul_graph_checker = GraphChecker.new(sea);
        ul_graph_checker.check();
        if (ul_graph_checker.errors.length > 0) {
            System.puts(Strings.format1("  FAIL  %s [unLEM graph check]\n", opcode));
            for (i < ul_graph_checker.errors.length)
                System.puts(Strings.format2("        %d: %q\n", i, ul_graph_checker.errors[i].render));
        }
	CBDTrace.addGraph(opcode, "unLEM", sea);

	def ul_opcode = Strings.format1("%s_ul", opcode);

	def ulscheduler = Scheduler.of_full_sea_info(sea, ssad_sea_info);
	ulscheduler.opcode = ul_opcode;
	ulscheduler.trace_full = should_trace(opcode);
	ulscheduler.schedule();

	def unlem_ssa_info = ulscheduler.bottom_block.toSSADSeaInfo();
	def unlem_ssa = unlem_ssa_info.0;
	def unlem_sea_info = unlem_ssa_info.1;
        def unlem_ssa_string = unlem_ssa.toString(0);
        def unlem_ssa_string_pretty = unlem_ssa.toStringPrettyWithSeaInfo(0, unlem_sea_info);
	CBDTrace.addString(opcode, "unlem_scheduler", "graph", ulscheduler.toMermaid());
	CBDTrace.addCode(opcode, "unlem_scheduler_ssa", unlem_ssa_string);
	CBDTrace.addCode(opcode, "unlem_scheduler_ssa_pretty", unlem_ssa_string_pretty);
        if (trace) {
            System.puts(Strings.format1("--- %s [unLEM] SSAD ---\n", opcode));
            System.puts(unlem_ssa_string_pretty);
            System.puts("\n---\n");
        }

	var ul_sc = ScheduleChecker.new(
		ulscheduler.top_block, ulscheduler.bottom_block,
		ulscheduler.orig_sea, ulscheduler.sea,
		ulscheduler.mapping, ulscheduler.clone_to_orig);
	ul_sc.check();
	reportResult(opcode, "unLEM", ul_sc.errors);

	return CBDDef.new(opcode, scheduler_ssad, scheduler_sea_info);
}

def main(args: Array<string>) {
	CBDTrace.init(TRACES_FILE);
	CBDInfo.init_with_file(CBDTrace.writer.out_file);

	IntrinsicTypes.init(IntrinsicTypes.TYPE_DEF_FILE);

	// Parse flags:
	//   --canonical        also test real opcodes from CanonicalDefs.v3
	//   --trace OPCODE     enable trace_full for the named opcode (repeatable)
	//   other args         opcode name filter
	var use_canonical = false;
	def opcode_args = Vector<string>.new();
	def trace_args = Vector<string>.new();
	var i = 0;
	while (i < args.length) {
		def arg = args[i];
		if (Strings.equal(arg, "--canonical")) { use_canonical = true; }
		else if (Strings.equal(arg, "--trace")) {
			i++;
			if (i < args.length) trace_args.put(args[i]);
		} else { opcode_args.put(arg); }
		i++;
	}
	trace_opcodes = trace_args.copy();
	def filter_args = opcode_args.copy();
	var run_cuts = filter_args.length == 0;
	for (arg in filter_args) if (Strings.equal(arg, "CONTROL_CUT")) run_cuts = true;
	if (run_cuts) {
		ScheduleCuts.run();
		total_tests += ScheduleCuts.total_tests;
		total_pass += ScheduleCuts.total_pass;
		total_fail += ScheduleCuts.total_fail;
	}

	// Load and test synthetic opcodes.
	def v3bytes = System.fileLoad(SYNTHETIC_V3);
	if (v3bytes == null) {
		System.puts(Strings.format1("Error reading %s\n", SYNTHETIC_V3));
		return;
	}
	def sexp_bytes = System.fileLoad(SYNTHETIC_SEXP);
	if (sexp_bytes == null) {
		System.puts(Strings.format1("Error reading %s\n", SYNTHETIC_SEXP));
		return;
	}

	def filterInstrs(all_instrs: Array<string>) -> Array<string> {
		if (filter_args.length == 0) return all_instrs;
		def filtered = Vector<string>.new();
		for (arg in filter_args) {
			for (name in all_instrs) {
				if (Strings.equal(name, arg)) { filtered.put(name); break; }
			}
		}
		return filtered.copy();
	}

	def syn_instrs = filterInstrs(TierGen.extractInstrNames(v3bytes));
	System.puts(Strings.format1("Running schedule tests on %d synthetic opcode(s)\n", syn_instrs.length));
	TierGen.extractDefs(syn_instrs, SYNTHETIC_SEXP, sexp_bytes, testOpcode);

	// Optionally load and test canonical opcodes.
	if (use_canonical) {
		def can_v3bytes = System.fileLoad(CANONICAL_V3);
		if (can_v3bytes == null) {
			System.puts(Strings.format1("Error reading %s\n", CANONICAL_V3));
			return;
		}
		def can_sexp_bytes = System.fileLoad(CANONICAL_SEXP);
		if (can_sexp_bytes == null) {
			System.puts(Strings.format1("Error reading %s\n", CANONICAL_SEXP));
			return;
		}
		def can_instrs = filterInstrs(TierGen.extractInstrNames(can_v3bytes));
		System.puts(Strings.format1("Running schedule tests on %d canonical opcode(s)\n", can_instrs.length));
		TierGen.extractDefs(can_instrs, CANONICAL_SEXP, can_sexp_bytes, testOpcode);
	}

	System.puts(Strings.format3("\nResults: %d passed, %d failed, %d total\n", total_pass, total_fail, total_tests));
	if (total_fail > 0) System.puts("FAILED\n");
	else System.puts("OK\n");
}
