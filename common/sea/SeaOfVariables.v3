class Sea {
    var start: IRNode;
    var finish: IRNode;
    var void_node: IRNode;
    var id_count: int;
    var nodes_by_id: Vector<IRNode> = Vector.new();

    var var_nodes: HashMap<string, IRNode> = Strings.newMap<IRNode>();

    new() {
        initEmpty();
        initDefault();
    }

    def initEmpty() {
        id_count = 0;
        nodes_by_id = Vector.new();
        var_nodes = Strings.newMap<IRNode>();
    }

    def initDefault() {
        def state_vars = Array<IRNode>.new(StateComponent.count);

        start = mkNode(IROp.Start, Array.new(state_vars.length), []);

        for (i < state_vars.length) state_vars[i] = start;
        finish = mkNode(IROp.Finish, Arrays.dup(state_vars), []);

        def void_node = mkNode(IROp.Lit(TypeVar.Bot("void"), "(void)"), Arrays.dup(state_vars), []);
        void_node.var_data = VarData.new("void", TypeVar.Bot("void"), Stage.VALIDATE);
        var_nodes["void"] = void_node;
    }

    def mkNode(op: IROp, state_deps: Array<IRNode>, value_deps: Array<IRNode>) -> IRNode {
        def node = IRNode.new(op, id_count);
        node.state_deps = state_deps;
        node.value_deps = value_deps;
        nodes_by_id.put(node);
        id_count += 1;

        if (!IROp.Lit.?(op))
            node.applyDeps(fun (dep: IRNode) { dep.addChild(node); });

        return node;
    }

    def dupNode(node: IRNode) -> IRNode {
        def n = mkNode(node.op, Arrays.dup(node.state_deps), Arrays.dup(node.value_deps));
        n.control_deps = Arrays.dup(node.control_deps);
        if(node.var_data != null) n.var_data = VarData.new(Seas.uidl(node.var_data.sourceName), node.var_data.tipe, node.var_data.stage);
        return n;
    }

    def cachedTransitiveDeps(node: IRNode) -> ImmNodeSet {
        if (node == null) return ImmNodeSets.empty();
        if (node.transitive_deps.bits != null) return node.transitive_deps;
        def r = [ImmNodeSets.single(node)];
        node.applyDeps(fun (dep: IRNode) { r[0] = r[0].union(cachedTransitiveDeps(dep)); });
        node.transitive_deps = r[0];
        return r[0];
    }

    def cachedTransitiveDepsPhiAware(node: IRNode) -> ImmNodeSet {
        if (node == null) return ImmNodeSets.empty();
        if (node.transitive_deps_phi.bits != null) return node.transitive_deps_phi;
        var result: ImmNodeSet;
        match (node.op) {
            Phi, StatePhi => {
                def cond = node.value_deps[0], l_branch = node.value_deps[1], r_branch = node.value_deps[2];
                def branch_common = cachedTransitiveDepsPhiAware(l_branch).intersection(cachedTransitiveDepsPhiAware(r_branch));
                result = ImmNodeSets.single(node)
                    .union(cachedTransitiveDepsPhiAware(cond))
                    .union(branch_common);
                for (dep in node.control_deps)
                    result = result.union(cachedTransitiveDepsPhiAware(dep));
            }
            _ => {
                def r = [ImmNodeSets.single(node)];
                node.applyDeps(fun (dep: IRNode) { r[0] = r[0].union(cachedTransitiveDepsPhiAware(dep)); });
                result = r[0];
            }
        }
        node.transitive_deps_phi = result;
        return result;
    }

    def clearDepsCache() {
        def empty = ImmNodeSet(null, 0);
        nodes_by_id.apply(fun(n: IRNode) { n.transitive_deps = empty; n.transitive_deps_phi = empty; });
    }

    def isAncestor(high: IRNode, low: IRNode) -> bool {
        if (high == low) return true;
        if (high == null || low == null) return false;
        return cachedTransitiveDeps(low).has(high);
    }

    def isDescendant(low: IRNode, high: IRNode) => isAncestor(high, low);

    def lowestCommonAncestors(nodes: Range<IRNode>) -> Vector<IRNode> {
        if (nodes.length == 0) return Vector.new();
        if (nodes.length == 1) return Vectors.of1(nodes[0]);

        // Intersect transitive deps of all nodes
        var common = nodes[0].transitiveDepsSet().put(nodes[0]);
        for (i = 1; i < nodes.length; i++) {
            def nodeDeps = nodes[i].transitiveDepsSet().put(nodes[i]);
            common = common.intersection(nodeDeps);
        }

        // Find roots (nodes with no children in common set)
        def commonVec = common.toVector();
        def results = Vector<IRNode>.new();
        for (i < commonVec.length) {
            def cn = commonVec[i];
            var isRoot = true;
            for (j < cn.children.length) {
                if (common.has(cn.children[j])) {
                    isRoot = false;
                    break;
                }
            }
            if (isRoot) results.put(cn);
        }
        return results;
    }

    def addSSAD(ssad: SSAD, state_vars: Array<IRNode>, deps: List<IRNode>, sea_info: SSADSeaInfo) {
        match (ssad) {
            LetApp(n, f, args, rest) => {
                def arg_nodes: Array<IRNode> = Arrays.map(args, fun (a: string) => var_nodes[a]);
                var intrinsic_def = Seas.intrinsic(f);

                def state_deps = Array<IRNode>.new(state_vars.length);
                for (sc in intrinsic_def.reads | intrinsic_def.writes)
                    state_deps[sc.tag] = state_vars[sc.tag];

                def op = IROp.Intrinsic(intrinsic_def);
                def node = var_nodes[n] = mkNode(op, state_deps, arg_nodes);
                node.var_data = VarData.new(n, TypeVar.Bot("bot"), Stage.VALIDATE);
                sea_info.recordLet(n, node);

                for (sc in intrinsic_def.writes) state_vars[sc.tag] = node;

                addSSAD(rest, state_vars, deps, sea_info);
            }
            LetLit(n, l, t, rest) => {
                def tp = TypeUtil.fromString(t);
                def op = IROp.Lit(tp, l);
                def node = var_nodes[n] = mkNode(op, start.state_deps, []);
                node.var_data = VarData.new(n, tp, Stage.VALIDATE);
                sea_info.recordLet(n, node);

                addSSAD(rest, state_vars, deps, sea_info);
            }
            If(cond, then, els, phis, rest) => {
                // Collect unique dest variable names from phis.
                def phi_vars = Vector<string>.new();
                for (phi in phis) {
                    var found = false;
                    for (i < phi_vars.length) if (Strings.equal(phi_vars[i], phi.0)) { found = true; break; }
                    if (!found) phi_vars.put(phi.0);
                }

                // Process else branch and capture phi arm values.
                // First try phi SOURCE names (SSA-renamed), then fall back to
                // dest name for variables not modified in this branch.
                def else_phis = Strings.newMap<IRNode>();
                def else_phi_names = Strings.newMap<string>();
                def else_state = Arrays.dup(state_vars);
                addSSAD(els, else_state, deps, sea_info);
                for (phi in phis) {
                    if (!else_phis.has(phi.0) && var_nodes.has(phi.1)) {
                        else_phis[phi.0] = var_nodes[phi.1];
                        else_phi_names[phi.0] = phi.1;
                    }
                }
                for (i < phi_vars.length) {
                    def v = phi_vars[i];
                    if (!else_phis.has(v) && var_nodes.has(v)) {
                        else_phis[v] = var_nodes[v];
                        else_phi_names[v] = v;
                    }
                }

                // Process then branch and capture phi arm values.
                // Then-arm sources come first in the phi list (from SSAD construction),
                // so the !has guard picks up the then-arm source before the
                // else-arm source that persists in var_nodes.
                def then_phis = Strings.newMap<IRNode>();
                def then_phi_names = Strings.newMap<string>();
                def then_state = Arrays.dup(state_vars);
                addSSAD(then, then_state, deps, sea_info);
                for (phi in phis) {
                    if (!then_phis.has(phi.0) && var_nodes.has(phi.1)) {
                        then_phis[phi.0] = var_nodes[phi.1];
                        then_phi_names[phi.0] = phi.1;
                    }
                }
                for (i < phi_vars.length) {
                    def v = phi_vars[i];
                    if (!then_phis.has(v) && var_nodes.has(v)) {
                        then_phis[v] = var_nodes[v];
                        then_phi_names[v] = v;
                    }
                }

                def cond_node = var_nodes[cond];

                def phi_map = Strings.newMap<IRNode>();
                for (phi in phis) {
                    def phi_var = phi.0;
                    if (!phi_map.has(phi_var)) {
                        def left = then_phis[phi_var], right = else_phis[phi_var];
                        def node = mkNode(IROp.Phi, Array.new(state_vars.length), [cond_node, left, right]);
                        var_nodes[phi_var] = node;
                        node.var_data = VarData.new(phi_var, TypeVar.Bot("bot"), Stage.VALIDATE);
                        sea_info.recordPhiSourceNames(node, then_phi_names[phi_var], else_phi_names[phi_var]);
                        sea_info.recordPhiArm(phi_var, then_phi_names[phi_var], node, left);
                        sea_info.recordPhiArm(phi_var, else_phi_names[phi_var], node, right);
                        phi_map[phi_var] = node;
                    }
                }

                // we merge state phis if they have the same left/right sources
                def state_phis = Vector<(IRNode, IRNode, StateComponent.set)>.new();
                for (sc in StateComponent.set.all) {
                    def left_sv = then_state[sc.tag], right_sv = else_state[sc.tag];
                    if (left_sv.id != right_sv.id) {
                        var idx = -1;
                        for (i < state_phis.length) {
                            def sp = state_phis[i];
                            if (sp.0.id == left_sv.id && sp.1.id == right_sv.id) {
                                idx = i;
                                break;
                            }
                        }
                        if (idx == -1) state_phis.put((left_sv, right_sv, sc));
                        else state_phis[idx] = (left_sv, right_sv, state_phis[idx].2 | sc);
                    }
                }

                for (i < state_phis.length) {
                    def left = state_phis[i].0, right = state_phis[i].1, scs = state_phis[i].2;
                    def phi_state_deps = Array<IRNode>.new(state_vars.length);
                    def node = mkNode(IROp.StatePhi(scs), phi_state_deps, [cond_node, left, right]);

                    for (sc in scs) state_vars[sc.tag] = node;
                }

                addSSAD(rest, state_vars, deps, sea_info);
            }
            Match => {}
            Void => {}
            Injected => {}
            Final => {}
        }
    }

    def toMermaid() -> string => SeaRender.toMermaidSea(this);

    def toMermaidExt(tag: string, buf: StringBuilder) -> StringBuilder => SeaRender.toMermaidExtSea(this, tag, buf);

    def apply<T>(init: T, f: (IRNode, Sea, T) -> Range<IRNode>) {
        def wl: Vector<IRNode> = Vector.new();
        var q_idx = 0;
        wl.put(finish);

        var completed = NodeSet.new();

        while (q_idx < wl.length) {
            def node = wl[q_idx];
            q_idx += 1;

            if (node == null || completed.has(node)) continue;
            completed.put(node);

            def next = f(node, this, init);
            for (arg in next) wl.put(arg);
        }
    }

    def subgraph2(top: IRNode, bot: IRNode) -> ImmNodeSet {
        if (top == null || bot == null) return ImmNodeSets.empty();
        if (top.id == bot.id) return ImmNodeSets.single(top);

        // Phase 1: Forward reachability from top via children edges
        def forward = NodeSet.new();
        def fwd_wl = Vector<IRNode>.new();
        fwd_wl.put(top);
        var fi = 0;
        while (fi < fwd_wl.length) {
            def node = fwd_wl[fi];
            fi++;
            if (node == null || forward.has(node)) continue;
            forward.put(node);
            for (i < node.children.length) fwd_wl.put(node.children[i]);
        }

        // Phase 2: Backward reachability from bot via dep edges
        def backward = NodeSet.new();
        def bwd_wl = Vector<IRNode>.new();
        bwd_wl.put(bot);
        var bi = 0;
        while (bi < bwd_wl.length) {
            def node = bwd_wl[bi];
            bi++;
            if (node == null || backward.has(node)) continue;
            backward.put(node);
            node.applyDeps(fun (dep: IRNode) { bwd_wl.put(dep); });
        }

        // Subgraph = intersection of forward and backward reachable sets
        def result = Vector<IRNode>.new();
        forward.apply(fun (node: IRNode) {
            if (backward.has(node)) result.put(node);
        });

        return ImmNodeSets.of_vec(result);
    }

    def rebuildChildren() {
        def allNodes = Vector<IRNode>.new();
        def visited = NodeSet.new();
        def wl = Vector<IRNode>.new();
        wl.put(finish);
        var idx = 0;

        while (idx < wl.length) {
            def node = wl[idx];
            idx += 1;
            if (node == null || visited.has(node)) continue;
            visited.put(node);
            allNodes.put(node);
            node.children = Vector.new();
            node.childSet = ImmNodeSets.empty();
            node.applyDeps(fun (dep: IRNode) { wl.put(dep); });
        }

        for (i < allNodes.length) {
            def node = allNodes[i];
            if (IROp.Lit.?(node.op) && node.control_deps.length == 0) continue;
            node.applyDeps(fun (dep: IRNode) { dep.addChild(node); });
        }
    }

    def branch_partition(node: IRNode) -> BranchPartition {
        def cond = node.value_deps[0], l_branch = node.value_deps[1], r_branch = node.value_deps[2];

        def cond_deps = cachedTransitiveDeps(cond);

        def l_phi_aware = cachedTransitiveDepsPhiAware(l_branch);
        def r_phi_aware = cachedTransitiveDepsPhiAware(r_branch);
        var frontier = cond_deps.union(l_phi_aware.intersection(r_phi_aware));
        for (dep in node.control_deps) frontier = frontier.union(cachedTransitiveDeps(dep));

        def l_full = cachedTransitiveDeps(l_branch);
        def r_full = cachedTransitiveDeps(r_branch);

        return BranchPartition(node, frontier, l_full.withoutAll(frontier), r_full.withoutAll(frontier));
    }
}

component Seas {
    def uidl = SSAD_IR.uidl;

    def intrinsic(name: string) -> IntrinsicTypedef #inline {
        def defn = IntrinsicTypes.intrinsic_types[name];
        if (defn != null) 
            return defn;
        else
            return IntrinsicTypedef.new(name, null, null, CBDEffect.None);
    }

    def ofSSAD(node: SSAD) -> Sea {
        return ofSSADWithInfo(node).0;
    }

    def ofSSADWithInfo(node: SSAD) -> (Sea, SSADSeaInfo) {
        def sea = Sea.new();
        def sea_info = SSADSeaInfo.new();

        def state_vars = sea.finish.state_deps;
        sea.addSSAD(node, state_vars, List.new(sea.start, null), sea_info);
        SeaAnalysis.inferVarData(sea);
        return (sea, sea_info);
    }

    def cloneSubgraph(sea: Sea, subgraph: ImmNodeSet) -> (ImmNodeSet, NodeMap<IRNode>) {
        def mapping = NodeMap<IRNode>.new();
        def nodes = subgraph.toArray(sea);

        for (old_node in nodes) {
            def new_node = IRNode.new(old_node.op, sea.id_count);
            sea.nodes_by_id.put(new_node);
            sea.id_count += 1;

            new_node.state_deps = Array<IRNode>.new(old_node.state_deps.length);
            new_node.value_deps = Array<IRNode>.new(old_node.value_deps.length);

            if (old_node.var_data != null) {
                new_node.var_data = VarData.new(
                    Seas.uidl(old_node.var_data.sourceName),
                    old_node.var_data.tipe,
                    old_node.var_data.stage
                );
            }

            mapping[old_node] = new_node;
        }

        for (old_node in nodes) {
            def new_node = mapping[old_node];

            for (j < old_node.value_deps.length) {
                def dep = old_node.value_deps[j];
                if (dep != null) {
                    new_node.value_deps[j] = if(subgraph.has(dep), mapping[dep], dep);
                }
            }

            for (j < old_node.state_deps.length) {
                def dep = old_node.state_deps[j];
                if (dep != null) {
                    new_node.state_deps[j] = if(subgraph.has(dep), mapping[dep], dep);
                }
            }
            new_node.control_deps = Arrays.map(old_node.control_deps,
                fun (dep: IRNode) => if(subgraph.has(dep), mapping[dep], dep));
        }

        def cloned = Vector<IRNode>.new();
        for (old_node in nodes) cloned.put(mapping[old_node]);
        def result = ImmNodeSets.of_array(cloned.extract());

        return (result, mapping);
    }

    def clone(sea: Sea) -> (Sea, NodeMap<IRNode>) {
        def liveNodes = live(sea);

        def new_sea = Sea.new();
        sea.rebuildChildren();
        new_sea.initEmpty();
        def mapping = NodeMap<IRNode>.new();

        sea.nodes_by_id.apply(fun (old_node: IRNode) {
            def new_node = IRNode.new(old_node.op, new_sea.id_count);
            new_sea.nodes_by_id.put(new_node);
            new_sea.id_count += 1;
            new_node.state_deps = Array<IRNode>.new(old_node.state_deps.length);
            new_node.value_deps = Array<IRNode>.new(old_node.value_deps.length);
            mapping[old_node] = new_node;
        });

        sea.nodes_by_id.apply(fun (old_node: IRNode) {
            def new_node = mapping[old_node];

            for (j < old_node.value_deps.length) if (old_node.value_deps[j] != null)
                new_node.value_deps[j] = mapping[old_node.value_deps[j]];
            for (j < old_node.state_deps.length) if (old_node.state_deps[j] != null)
                new_node.state_deps[j] = mapping[old_node.state_deps[j]];
            new_node.control_deps = Arrays.map(old_node.control_deps, fun (dep: IRNode) => mapping[dep]);

            if (old_node.var_data != null) {
                new_node.var_data = VarData.new(
                    old_node.var_data.sourceName,
                    old_node.var_data.tipe,
                    old_node.var_data.stage
                );
            }
        });

        new_sea.start = mapping[sea.start];
        new_sea.finish = mapping[sea.finish];
        new_sea.rebuildChildren();

        return (new_sea, mapping);
    }

    def collectLiveAux(node: IRNode, sea: Sea, state: NodeSet) -> Range<IRNode> {
        state.put(node);
        return node.deps();
    }

    def live(sea: Sea) -> NodeSet {
        def liveSet = NodeSet.new();
        sea.apply(liveSet, collectLiveAux);
        return liveSet;
    }
}

type BranchPartition(phi: IRNode, frontier: ImmNodeSet, l_subgraph: ImmNodeSet, r_subgraph: ImmNodeSet);

def dedup(arr: Array<IRNode>) -> Array<IRNode> #inline {
    def res = Vector<IRNode>.new();
    for (n in arr) {
        if (n == null) continue;
        var dup = false;
        for (i < res.length) dup |= res[i].id == n.id;
        if (!dup) res.put(n);
    }
    return res.copy();
}

class IRNode {
    var op: IROp;
    var id: int;
    var var_data: VarData;

    var value_deps: Array<IRNode>;
    var state_deps: Array<IRNode>; // idx = statecomp.tag
    var control_deps: Array<IRNode> = []; // completion controls; not operator arguments
    var children: Vector<IRNode> = Vector.new();
    var childSet: ImmNodeSet = ImmNodeSets.empty();

    var move_true: IRNode;
    var move_false: IRNode;
    var unscheduled_use_count: int;
    var transitive_deps: ImmNodeSet;
    var transitive_deps_phi: ImmNodeSet;

    new(op, id) { }

    def deps() -> Array<IRNode> #inline {
        // should be empty, special case is to remove null state deps
        if (IROp.Start.?(op)) return dedup(value_deps);
        else return dedup(Arrays.concat(Arrays.concat(value_deps, state_deps), control_deps));
    }

    def applyDeps(f: IRNode -> void) #inline {
        for (i < value_deps.length) {
            def d = value_deps[i];
            if (d == null) continue;
            var dup = false;
            for (j < i) if (value_deps[j] != null && value_deps[j].id == d.id) { dup = true; break; }
            if (!dup) f(d);
        }
        if (IROp.Start.?(op)) return;
        for (i < state_deps.length) {
            def d = state_deps[i];
            if (d == null) continue;
            var dup = false;
            for (v in value_deps) if (v != null && v.id == d.id) { dup = true; break; }
            if (!dup) for (j < i) if (state_deps[j] != null && state_deps[j].id == d.id) { dup = true; break; }
            if (!dup) f(d);
        }
        for (i < control_deps.length) {
            def d = control_deps[i];
            var dup = false;
            for (v in value_deps) if (v == d) { dup = true; break; }
            if (!dup) for (s in state_deps) if (s == d) { dup = true; break; }
            if (!dup) for (j < i) if (control_deps[j] == d) { dup = true; break; }
            if (!dup) f(d);
        }
    }

    def addChild(child: IRNode) #inline {
        children.put(child);
        childSet = childSet.with(child);
    }

    def transitiveDepsAux(buf: NodeSet) {
        for (dep in deps()) if (dep != null) {
            buf.put(dep);
            dep.transitiveDepsAux(buf);
        }
    }

    def transitiveDepsSet() -> NodeSet {
        def buf = NodeSet.new();
        transitiveDepsAux(buf);
        return buf;
    }

    def replaceDep(from: IRNode, to: IRNode) -> this {
        for (i < value_deps.length)
            if (value_deps[i].id == from.id) value_deps[i] = to;

        for (i < state_deps.length)
            if (state_deps[i] != null && state_deps[i].id == from.id) state_deps[i] = to;
        for (i < control_deps.length)
            if (control_deps[i] == from) control_deps[i] = to;
    }

    def init_move(sea: Sea) -> bool {
        if (move_true == null) {
            move_true = sea.mkNode(IROp.Move(true), Array.new(StateComponent.count), []);
            move_false = sea.mkNode(IROp.Move(false), Array.new(StateComponent.count), []);
            return false;
        }
        return true;
    }

    def hash() -> int => id;
    def eq(rhs: IRNode) -> bool => id == rhs.id;

    def render(sb: StringBuilder) -> StringBuilder => SeaRender.renderIRNode(this, sb);

    def toMermaidNode(buf: StringBuilder, tag: string) -> StringBuilder => SeaRender.toMermaidNodeIRNode(this, buf, tag);

    def become(other: IRNode) -> this {
        op = other.op;
        var_data = other.var_data;
        value_deps = other.value_deps;
        state_deps = other.state_deps;
        control_deps = other.control_deps;
        for (i < children.length) {
            def child = children[i];
            for (j < child.value_deps.length) if (child.value_deps[j] == this) child.value_deps[j] = other;
            for (j < child.state_deps.length) if (child.state_deps[j] == this) child.state_deps[j] = other;
            for (j < child.control_deps.length) if (child.control_deps[j] == this) child.control_deps[j] = other;
        }
        children = other.children;
        childSet = other.childSet;
    }

    def graph_eq(rhs: IRNode) -> DiffResult {
        // Compare value/state semantics; scheduling may strengthen control edges.
        // Unwrap Move nodes to compare underlying values
        def lhs = this.unwrapMove();
        def rhs_unwrapped = rhs.unwrapMove();

        // If either was unwrapped, delegate to unwrapped comparison
        if (lhs != this || rhs_unwrapped != rhs) {
            return lhs.graph_eq(rhs_unwrapped);
        }

        if (!op.eq(rhs.op)) return DiffResult.OpDiff(this, rhs);

        if (value_deps.length != rhs.value_deps.length) return DiffResult.ValueDepLen(this, rhs);
        if (state_deps.length != rhs.state_deps.length) return DiffResult.StateDepLen(this, rhs);

        for (i < value_deps.length) {
            if (value_deps[i] == null && rhs.value_deps[i] == null) continue; // both null
            if (value_deps[i] == null || rhs.value_deps[i] == null)
                return DiffResult.ValueDiff(this, rhs, i, DiffResult.OneNull(value_deps[i], rhs.value_deps[i]));

            def diff_res = value_deps[i].graph_eq(rhs.value_deps[i]);
            if (!DiffResult.GraphsEqual.?(diff_res))
                return DiffResult.ValueDiff(this, rhs, i, diff_res);
        }

        for (sc in StateComponent.set.all) {
            if (state_deps[sc.tag] == null && rhs.state_deps[sc.tag] == null) continue; // both null
            if (state_deps[sc.tag] == null || rhs.state_deps[sc.tag] == null)
                return DiffResult.OneNull(state_deps[sc.tag], rhs.state_deps[sc.tag]);

            def diff_res = state_deps[sc.tag].graph_eq(rhs.state_deps[sc.tag]);
            if (!DiffResult.GraphsEqual.?(diff_res))
                return DiffResult.StateDiff(this, rhs, sc, diff_res);
        }

        return DiffResult.GraphsEqual;
    }

    def is_phi() -> bool => IROp.Phi.?(op) || IROp.StatePhi.?(op);
    def is_move() -> bool => IROp.Move.?(op);

    // Unwrap Move nodes to get the underlying value for comparison.
    // - Value Move (from Phi): value_deps = [cond, actual_value], returns value_deps[1]
    // - State Move (from StatePhi): value_deps = [cond], state in state_deps,
    //   returns first non-null state_dep (all populated slots point to same node in practice)
    def unwrapMove() -> IRNode {
        match (op) {
            Move(_) => {
                if (value_deps.length > 1) return value_deps[1].unwrapMove();
                for (i < state_deps.length)
                    if (state_deps[i] != null) return state_deps[i].unwrapMove();

                return this; // unreachable
            }
            _ => return this;
        }
    }
}

type DiffResult {
    case GraphsEqual;
    case OpDiff(lhs: IRNode, rhs: IRNode);
    case OneNull(lhs: IRNode, rhs: IRNode);
    case ValueDepLen(lhs: IRNode, rhs: IRNode);
    case StateDepLen(lhs: IRNode, rhs: IRNode);

    case ValueDiff(lhs: IRNode, rhs: IRNode, idx: int, reason: DiffResult);
    case StateDiff(lhs: IRNode, rhs: IRNode, statecomp: StateComponent, reason: DiffResult);

    def render(sb: StringBuilder) -> StringBuilder => SeaRender.renderDiffResult(this, sb);
}

class VarData {
    var tipe: TypeVar;
    var stage: Stage;
    var sourceName: string; // var name in source def, preserved for generating nice code

    new(sourceName, tipe, stage) {}
}

type IROp {
    case Start;
    case Finish;
    case Intrinsic(defn: IntrinsicTypedef);
    case Lit(tipe: TypeVar, rep: string);
    case Phi;
    case StatePhi(statecomps: StateComponent.set);
    // case MatchPhi(subj: IRNode, end: IRNode, cases: Array<IRNode>);

    case Move(val: bool);

    def eq(rhs: IROp) -> bool {
        match (this) {
            Start => return IROp.Start.?(rhs);
            Finish => return IROp.Finish.?(rhs);
            Phi => return IROp.Phi.?(rhs);
            Intrinsic(d1) => match (rhs) {
                Intrinsic(d2) => return Strings.equal(d1.name, d2.name);
                _ => return false;
            }
            Lit(t1, r1) => match (rhs) {
                Lit(t2, r2) => return t1 == t2 && Strings.equal(r1, r2);
                _ => return false;
            }
            StatePhi(sc1) => match (rhs) {
                StatePhi(sc2) => return sc1 == sc2;
                _ => return false;
            }
            Move(v1) => match (rhs) {
                Move(v2) => return v1 == v2;
                _ => return false;
            }
        }
    }
}
