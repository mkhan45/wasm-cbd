        }
        out.ln();
        return out;
    }

    def renderStackWhole(out: StringBuilder) -> StringBuilder {
        out.putc('|').sp();
        for (i = it.frame.fp; i < it.values.top; i += 1) {
            out.putq(Values.render(it.values.elems[i], _));
            if (i - it.frame.fp == it.frame.func.decl.num_locals - it.frame.func.decl.sig.params.length) out.puts(" | ");
